<Window x:Class="ClickyWindows.CompanionPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Companion Panel"
        Height="400"
        Width="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">
    <Border Background="{StaticResource BackgroundBrush}"
            CornerRadius="10"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Text="Clicky Companion"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Status -->
            <TextBlock x:Name="StatusTextBlock"
                       Text="Ready to listen"
                       Foreground="#ccc"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Grid.Row="1"
                       Margin="0,0,0,20"/>

            <!-- Instructions -->
            <TextBlock Text="Press Ctrl+Alt to start voice input"
                       Foreground="#888"
                       FontSize="12"
                       TextAlignment="Center"
                       Grid.Row="2"
                       VerticalAlignment="Center"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Grid.Row="3"
                        Margin="0,20,0,0">
                <Button Content="Settings"
                        Width="80"
                        Margin="0,0,10,0"
                        Background="#333"
                        Foreground="White"
                        BorderBrush="#555"/>
                <Button Content="Quit"
                        Width="80"
                        Background="#333"
                        Foreground="White"
                        BorderBrush="#555"
                        Click="QuitButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>